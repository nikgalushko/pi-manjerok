{
  "name": "pi-manjerok",
  "version": "0.1.0",
  "description": "Deterministic multi-agent routing state machine (worker \u21c4 verifier \u21c4 senior \u21c4 reviewer) for pi, built on pi-subagents workflowScript",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "workflow",
    "state-machine"
  ],
  "files": [
    "extensions/",
    "agents/",
    "manjerok.example.json",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/manjerok/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:explore": "node scripts/report-workflow-exploration.mjs",
    "test:mutations": "node scripts/check-workflow-mutations.mjs"
  }
}
